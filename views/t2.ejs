<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link rel="stylesheet" href="./styles/try.css">
</head>
<body>
    <div class="wbd">
        <p>welcome to WBD Class 1</p>
    </div>

    <form  action="/process" method="post">
        <input type="hidden" name="_csrf" value=<%=csrftoken%> >
        <div>
            <label>Course Name:</label>
            <input type="text" name="courseName" placeholder="Please enter course name" required>
        </div>
        <div>
            <label>Name:</label>
            <input type="text" name="name" placeholder="Please enter your name" required>
        </div>
        <div>
            <label>Roll Number:</label>
            <input type="text" name="roll" placeholder="Please enter your roll number" required>
        </div>
        <div>
            <label>Expectations</label>
            <textarea name="expectations"  rows="4" required></textarea>
        </div>

        <button type="submit">Submit</button>
    </form>

    
</body>
</html>