<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= name %></title>
    <link rel="stylesheet" href="/styles/carehome_dashboard.css">
    <link href="/styles/ngo_das.css" rel="stylesheet" />
    <link rel="stylesheet" href="/styles/footer.css">
    <link rel="stylesheet" href="/styles/landing_page.css">
</head>
<body>
    
    <header id="header">
        <a href="/" style="font-size: large;">CareConnect</a>
        <nav >
            <ul class="header_right">
                <a href="/logout" style="margin-right: 3rem;">Logout</a>
                <a href="/<%= careid %>/edit" style="margin-right: 3rem;">Edit Profile</a>
            </ul>  
        </nav>
    </header>
      
      <h1><%= name %></h1>

    <aside class="wishlist">
        <h2>Wishlist of Needs</h2>
        <ul>
                    <% let wishlistArray = []; %>
        <% if (wishlist && typeof wishlist === 'string') { %>
            <% wishlistArray = wishlist.split(',').map(item => item.trim()); %>
        <% } else if (Array.isArray(wishlist)) { %>
            <% wishlistArray = wishlist; %>
        <% } %>

        <% if (wishlistArray.length > 0) { %>
            <% wishlistArray.forEach(item => { %>
                <li><%= item.replace(/</g, "&lt;").replace(/>/g, "&gt;") %></li>
            <% }); %>
        <% } else { %>
            <li>No items in wishlist. Please go to the edit page to update.</li>
        <% } %>

        </ul>
    </aside>

    <main class="dashboard">
        
        <button class="toggle-button" onclick="toggleStats()">Show Dashboard Stats</button>
        <section class="dashboard-stats" id="dashboard-stats">
            <div class="stats-row">
                <div class="stat-card">
                    <h3>Active Fundraisers</h3>
                    <p class="stat-value"><%= ongoing_fund.length %></p>
                </div>
                <% if (Array.isArray(stats) && stats.length > 0) { %>
                    <% stats.forEach(stat => { %>
                        <div class="stat-card">
                            <h3><%= stat.title.replace(/</g, "&lt;").replace(/>/g, "&gt;") %></h3>
                            <p class="stat-value"><%= stat.value %></p>
                        </div>
                    <% }); %>
                <% } else { %>
                    <p>No stats available.</p>
                <% } %>
            </div>
        </section>

        <section class="fundraisers">
            <h2>Current Associated Fundraisers</h2>
            <div class="fundraiser-list">
                <% if (Array.isArray(ongoing_fund) && ongoing_fund.length > 0) { %>
                    <% ongoing_fund.forEach((fundraiser, index) => { %>
                        <div class="fundraiser-card <%= index > 0 ? 'hidden' : '' %>">
                            <h3><%= fundraiser.fundraiser_name.replace(/</g, "&lt;").replace(/>/g, "&gt;") %></h3>
                            <p>Raised: ₹<%= fundraiser.amount_raised_so_far %> / ₹<%= fundraiser.goal_amount %></p>
                            <div class="progress-bar">
                                <div class="progress" style="width:<%= (fundraiser.amount_raised_so_far / fundraiser.goal_amount) * 100 %>%"></div>
                            </div>
                        </div>
                    <% }); %>
                <% } else { %>
                    <p>No active ongoingfund.</p>
                <% } %>
            </div>

            <% if (ongoing_fund.length >1) { %>
                <button id="viewMoreFundraisers" class="view-toggle-btn">View More</button>
                <button id="viewLessFundraisers" class="view-toggle-btn hidden">View Less</button>
            <% } %>
        </section>
    </main>

    <div class="donations-section">
        <h2>Recent Donations from Users</h2>
        <div id="donations-list">
            <% if (recentDonations && recentDonations.length > 0) { %>
                <% recentDonations.slice(0, 3).forEach(donation => { %>
                    <div class="donation"> 
                        <strong><%= donation.donor_name.replace(/</g, "&lt;").replace(/>/g, "&gt;") %></strong> donated ₹<%= donation.amount %>
                    </div>
                <% }); %>
            <% } else { %>
                <p>No recent donations available.</p>
            <% } %>
        </div>
    </div>

    <%- include('../shared/includes/footer') %>

    <script src="/scripts/carehomes_dashboard.js"></script>
</body>
</html>