<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Help Age India Carehome</title>
    <link rel="stylesheet" href="/carehome_dashboard.css">
    <script src="/carehome_dashboard.js" defer></script>
</head>
<body>

    <h1>Help Age India Carehome</h1>

    <!-- Sidebar Wishlist -->
    <aside class="wishlist">
        <h2>Wishlist of Needs</h2>
        <ul>
            <% if (Array.isArray(wishlist) && wishlist.length > 0) { %>
                <% wishlist.forEach(item => { %>
                    <li><%= item.replace(/</g, "&lt;").replace(/>/g, "&gt;") %></li>
                <% }); %>
            <% } else { %>
                <li>No items in wishlist. Please go to the edit page to update.</li>
            <% } %>
        </ul>
    </aside>

    <!-- Main Dashboard -->
    <main class="dashboard">
        <!-- Toggle Dashboard Stats -->
        <button class="toggle-button" onclick="toggleStats()">Show Dashboard Stats</button>
        
        <!-- Dashboard Stats -->
        <section class="dashboard-stats" id="dashboard-stats">
            <div class="stats-row">
                <% if (Array.isArray(stats) && stats.length > 0) { %>
                    <% stats.forEach(stat => { %>
                        <div class="stat-card">
                            <h3><%= stat.title.replace(/</g, "&lt;").replace(/>/g, "&gt;") %></h3>
                            <p class="stat-value"><%= stat.value %></p>
                        </div>
                    <% }); %>
                <% } else { %>
                    <p>No stats available.</p>
                <% } %>
            </div>
        </section>

        <!-- Fundraisers -->
        <section class="fundraisers">
            <h2>Current Fundraisers</h2>
            <div class="fundraiser-list">
                <% if (Array.isArray(fundraisers) && fundraisers.length > 0) { %>
                    <% fundraisers.forEach((fundraiser, index) => { %>
                        <div class="fundraiser-card <%= index > 0 ? 'hidden' : '' %>">
                            <h3><%= fundraiser.title.replace(/</g, "&lt;").replace(/>/g, "&gt;") %></h3>
                            <p>Raised: ₹<%= fundraiser.raised %> / ₹<%= fundraiser.goal %></p>
                            <div class="progress-bar">
                                <div class="progress" style=`width: <%= ((fundraiser.raised / fundraiser.goal) * 100) + '%' %>`></div>
                            </div>
                        </div>
                    <% }); %>
                <% } else { %>
                    <p>No active fundraisers.</p>
                <% } %>
            </div>
        
            <% if (fundraisers.length > 1) { %>
                <button id="viewMoreBtn" class="view-toggle-btn">View More</button>
                <button id="viewLessBtn" class="view-toggle-btn hidden">View Less</button>
            <% } %>
        </section>
        
        <!-- Donations from Users -->
        <section class="donations">
            <h2>Recent Donations from Users</h2>
            <div class="donation-list">
                <% if (Array.isArray(donations) && donations.length > 0) { %>
                    <% donations.forEach(donation => { %>
                        <div class="donation-card">
                            <p><%= donation.donor.replace(/</g, "&lt;").replace(/>/g, "&gt;") %> donated ₹<%= donation.amount %></p>
                        </div>
                    <% }); %>
                <% } else { %>
                    <p>No recent donations.</p>
                <% } %>
            </div>
        </section>
    </main>

    <script src="/carehome_dashboard.js" defer></script>

    <footer class="footer">
        <div class="footer-container">
            <div class="footer-section">
                <h3>About CareConnect</h3>
                <p>CareConnect bridges NGOs, care homes, and generous donors. We empower individuals to support meaningful initiatives and create lasting impact.</p>
            </div>
            
            <div class="footer-section">
                <h3>Quick Links</h3>
                <ul class="footer-links">
                    <li><a href="/">Home</a></li>
                    <li><a href="/discover/ngos">Discover NGOs</a></li>
                    <li><a href="/carehomes">Find Care Homes</a></li>
                    <li><a href="/fundraisers">Current Fundraisers</a></li>
                    <li><a href="/donate/items">Donate Food/Clothes</a></li>
                    <li><a href="/dashboard">User Dashboard</a></li>
                </ul>
            </div>
            
            <div class="footer-section">
                <h3>Newsletter</h3>
                <p>Stay updated with our latest fundraisers and success stories.</p>
                <div class="newsletter-signup">
                    <input type="email" placeholder="Your email" name="email">
                    <button>Subscribe</button>
                </div>
                <p>Join our community of 10,000+ donors making a difference every day.</p>
            </div>
            
            <div class="footer-section">
                <h3>Contact Us</h3>
                <form class="contact-form" method="POST" action="/contact">
                    <input type="text" placeholder="Name" name="name" required>
                    <input type="email" placeholder="Email" name="email" required>
                    <textarea placeholder="Message" rows="3" name="message" required></textarea>
                    <button type="submit">Send Message</button>
                </form>
            </div>
        </div>
        
        <div class="footer-bottom">
            <p>&copy; 2025 CareConnect. All rights reserved.</p>
            <p>Created by <%= typeof teamMembers !== 'undefined' ? teamMembers.replace(/</g, "&lt;").replace(/>/g, "&gt;") : 'Our Team' %></p>
        </div>
    </footer>
</body>
</html>