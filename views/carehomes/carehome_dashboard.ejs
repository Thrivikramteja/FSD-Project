<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= name %></title>
  <link rel="stylesheet" href="/styles/carehome_dashboard.css"> 
  <link href="/styles/ngo_das.css" rel="stylesheet" /> 
  <link rel="stylesheet" href="/styles/footer.css"> 
  <link rel="stylesheet" href="/styles/landing_page.css">
</head>
<body>
    <a href="/carehome-dashboard/get-job" class="btn create-job-btn"></a>
    <header id="header">
        <a href="/" style="font-size: large;">CareConnect</a>
        <nav >
            <ul class="header_right">
                <a href="/logout" style="margin-right: 3rem;">Logout</a>
                <a href="/carehome-dashboard/<%= careid %>/edit" style="margin-right: 3rem;">Edit Profile</a>
                <a href="/carehome-dashboard/get-job">Create a job</a>
            </ul>  
        </nav>
    </header>
      
      <h1><%= name %></h1>

  <!-- Main Content -->
  <div class="container">
    <!-- Wishlist Sidebar -->
    <aside class="wishlist">
      <h2>Wishlist of Needs</h2>
      <ul>
        <% let wishlistArray = []; %>
        <% if (wishlist && typeof wishlist === 'string') { %>
          <% wishlistArray = wishlist.split(',').map(item => item.trim()); %>
        <% } else if (Array.isArray(wishlist)) { %>
          <% wishlistArray = wishlist; %>
        <% } %>

        <% if (wishlistArray.length > 0) { %>
          <% wishlistArray.forEach(item => { %>
            <li><%= item.replace(/</g, "&lt;").replace(/>/g, "&gt;") %></li>
          <% }); %>
        <% } else { %>
          <li>No items in wishlist. Please go to the edit page to update.</li>
        <% } %>
      </ul>
    </aside>

    <!-- Dashboard Main Section -->
    <main class="dashboard">
      <h1><%= name %></h1>

      <!-- Dashboard Stats -->
      <button class="btn toggle-btn" onclick="toggleStats()">Show Dashboard Stats</button>
      <section class="dashboard-stats" id="dashboard-stats">
        <div class="stats-row">
          <div class="stat-card">
            <h3>Active Fundraisers</h3>
            <p class="stat-value"><%= ongoing_fund.length %></p>
          </div>
          <% if (Array.isArray(stats) && stats.length > 0) { %>
            <% stats.forEach(stat => { %>
              <div class="stat-card">
                <h3><%= stat.title.replace(/</g, "&lt;").replace(/>/g, "&gt;") %></h3>
                <p class="stat-value"><%= stat.value %></p>
              </div>
            <% }); %>
          <% } else { %>
            <p>No stats available.</p>
          <% } %>
        </div>
      </section>

      <!-- Fundraisers -->
      <section class="fundraisers">
        <h2>Current Associated Fundraisers</h2>
        <div class="fundraiser-list">
          <% if (Array.isArray(ongoing_fund) && ongoing_fund.length > 0) { %>
            <% ongoing_fund.forEach((fundraiser, index) => { %>
              <div class="fundraiser-card <%= index > 0 ? 'hidden' : '' %>">
                <h3><%= fundraiser.fundraiser_name.replace(/</g, "&lt;").replace(/>/g, "&gt;") %></h3>
                <p>Raised: ₹<%= fundraiser.amount_raised_so_far %> / ₹<%= fundraiser.goal_amount %></p>
                <div class="progress-bar">
                  <div class="progress" style="width:<%= (fundraiser.amount_raised_so_far / fundraiser.goal_amount) * 100 %>%"></div>
                </div>
              </div>
            <% }); %>
          <% } else { %>
            <p>No active fundraisers.</p>
          <% } %>
        </div>

        <% if (ongoing_fund.length > 1) { %>
          <div class="button-container">
            <button id="viewMoreFundraisers" class="btn">View More</button>
            <button id="viewLessFundraisers" class="btn hidden">View Less</button>
          </div>
        <% } %>
      </section>

      <!-- Recent Donations -->
      <section class="donations-section">
        <h2>Recent Donations from Users</h2>
        <div id="donations-list">
          <% if (recentDonations && recentDonations.length > 0) { %>
            <% recentDonations.slice(0, 3).forEach(donation => { %>
              <div class="donation"> 
                <strong><%= donation.donor_name.replace(/</g, "&lt;").replace(/>/g, "&gt;") %></strong> 
                donated ₹<%= donation.amount %>
              </div>
            <% }); %>
          <% } else { %>
            <p>No recent donations available.</p>
          <% } %>
        </div>
      </section>

      <!-- Decide Item Donations -->
      <section class="message-section">
        <h2>Decide Item Donations</h2>
        <div class="message-list">
          <% if (messages && messages.length > 0) { %>
            <% messages.forEach(message => { %>
              <div class="message-item">
                <form method="POST" action="/donate_item/action">
                  <input type="hidden" name="userId" value="<%= message.userId %>">
                  <input type="hidden" name="carehomeId" value="<%= message.carehomeId %>">
                  <input type="hidden" name="category" value="<%= message.category %>">
                  <input type="hidden" name="delivery_date" value="<%= message.delivery_date %>">
                  <input type="hidden" name="location" value="<%= message.location %>">
                  <input type="hidden" name="description" value="<%= message.description %>">
                  <input type="hidden" name="action" value="">
                  
                  <p><strong>Category:</strong> <%= message.category %></p>
                  <p><strong>Location:</strong> <%= message.location %></p>
                  <p><strong>Delivery Date:</strong> <%= new Date(message.delivery_date).toLocaleDateString() %></p>
                  <div class="button-group">
                    <button type="submit" class="btn accept" onclick="setAction(this, 'accept')">Accept</button>
                    <button type="submit" class="btn reject" onclick="setAction(this, 'reject')">Reject</button>
                  </div>
                </form>
              </div>
            <% }); %>
          <% } else { %>
            <p>No recent item messages available.</p>
          <% } %>
        </div>
      </section>

      <!-- Donation Items -->
      <section class="donation-items-container">
        <h2 class="donation-header">Donation Items</h2>
        <% if (items.length > 0) { %>
          <% items.forEach(item => { %>
            <div class="donation-item">
              <h5 class="donation-category">Category: <%= item.category %></h5>
              <p class="donation-detail"><strong>Location:</strong> <%= item.location %></p>
              <p class="donation-detail"><strong>Delivery Date:</strong> <%= new Date(item.delivery).toLocaleDateString() %></p>
              <p class="donation-detail"><strong>Donated At:</strong> <%= new Date(item.donated_at).toLocaleDateString() %></p>
            </div>
          <% }); %>
        <% } else { %>
          <p class="no-items">No items available.</p>
        <% } %>
      </section>
    </main>
  </div>

  <!-- Footer -->
  <%- include('../shared/includes/footer') %>

  <!-- Scripts -->
  <script>
    function setAction(button, action) {
      const form = button.closest('form');
      form.querySelector('input[name="action"]').value = action;
    }

    function toggleStats() {
      const stats = document.getElementById("dashboard-stats");
      const btn = document.querySelector(".toggle-btn");
      if (stats.style.display === "block") {
        stats.style.display = "none";
        btn.textContent = "Show Dashboard Stats";
      } else {
        stats.style.display = "block";
        btn.textContent = "Hide Dashboard Stats";
      }
    }

    const viewMoreBtn = document.getElementById("viewMoreFundraisers");
    const viewLessBtn = document.getElementById("viewLessFundraisers");
    const fundraiserCards = document.querySelectorAll(".fundraiser-card");

    if (viewMoreBtn && viewLessBtn) {
      viewMoreBtn.addEventListener("click", () => {
        fundraiserCards.forEach(card => card.classList.remove("hidden"));
        viewMoreBtn.classList.add("hidden");
        viewLessBtn.classList.remove("hidden");
      });

      viewLessBtn.addEventListener("click", () => {
        fundraiserCards.forEach((card, idx) => {
          if (idx > 0) card.classList.add("hidden");
        });
        viewMoreBtn.classList.remove("hidden");
        viewLessBtn.classList.add("hidden");
      });
    }
  </script>
</body>
</html>
