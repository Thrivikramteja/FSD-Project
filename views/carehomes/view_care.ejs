<!DOCTYPE html>
<html>
    <head>
        <title><%= details.name_carehome %></title>
        <link href="/styles/view_care.css" rel="stylesheet">
    </head>
    <body>

        <h2 class="name_care"><%= details.name_carehome %></h2>
        <hr>
        <div class="description">
            <h3>Description:</h3>
            <p><%= details.description %></p>
        </div>
        <div class="stat_content">

            <div class="wishlist">
                <h3>Wishlist</h3>
                <% if (!details.wishlist || details.wishlist.length === 0) { %>
                    <p>No wishlist provided by care home</p>
                <% } else { %>
                    <ul>
                        <% details.wishlist.forEach(item => { %>
                            <li class="wish"><%= item %></li>
                        <% }); %>
                    </ul>
                <% } %>
            </div>
            
            <div class="care_stats">
                <h3>Stats</h3>
                <ul>
                    

                    <li><span class="left">Residents: </span><span class="right"><%= details.number_of_residents %></span></li>
                    <li><span class="left">Monthly Expense: </span><span class="right"><%= details.avg_monthly_expenses %></span></li>
                    <li><span class="left">Avg resident Expense: </span><span class="right"><%= (details.avg_monthly_expenses/details.number_of_residents).toFixed(2) %></span></li>
                    
                    
                </ul>
            </div>
        </div>
    </body>
</html>