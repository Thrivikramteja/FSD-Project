<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Care Homes</title>

    <link rel="stylesheet" href="/styles/carehome.css" />
    <link rel="stylesheet" href="/styles/landing_page.css" />
    <link rel="stylesheet" href="/styles/slide.css">
    <link rel="stylesheet" href="/styles/footer.css" />
  </head>
  <body>
    <%- include('../shared/includes/header') %>
    <h1 style="text-align: center; font-size: 1.75rem">
      List of Care Homes Associated with CareConnect
    </h1>
    <div class="nonprofit-container">
      <% carehomes.forEach(carehome => { %>
      <div class="card">
        <div class="content">
          <img src="/<%= carehome.imagePath %>" alt="Carehome Image">
          <h2 style="padding: 1rem;"><%= carehome.care_home_name %></h2>
          <div class="location">
            <a href="#city"><%= carehome.city %></a> |
            <a href="#state"><%= carehome.state %></a>
          </div>
          <p style="padding: 0.1rem;"><%= carehome.description %></p>
          <div class="buttons">
            <a
              href="/carehomes/viewcare/<%= carehome.carehomeId %>"
              class="details-btn"
              >View Details</a
            >
            <a
              href="/donate_money?carehome_id=<%= carehome.carehomeId %>"
              class="donate-btn"
              >Donate</a
            >
          </div>
        </div>
      </div>
      <% }); %>
    </div>
    <%- include('../shared/includes/footer') %>
  </body>

  <script>
    async function fetchCareHomes() {
      const container = document.getElementById("carehomeContainer");
      const loadingText = document.getElementById("loadingText");

      try {
        // 👇 since your route is '/carehomes'
        const response = await fetch("/carehomes", { cache: "no-store" });

        if (!response.ok) throw new Error("Failed to fetch care homes.");

        const data = await response.json();
        loadingText.style.display = "none";

        if (!data.length) {
          container.innerHTML = "<p style='text-align:center;'>No care homes found.</p>";
          return;
        }

        data.forEach((home) => {
          const card = document.createElement("div");
          card.classList.add("card");
          card.innerHTML = `
            <div class="content">
              <h2>${home.care_home_name}</h2>
              <div class="location">
                <a href="#city">${home.city}</a> | <a href="#state">${home.state}</a>
              </div>
              <p>${home.description || "No description available."}</p>
              <div class="buttons">
                <a href="/carehomes/viewcare/${home.carehomeId}" class="details-btn">View Details</a>
                <a href="/donate_money?carehome_id=${home.carehomeId}" class="donate-btn">Donate</a>
              </div>
            </div>
          `;
          container.appendChild(card);
        });
      } catch (err) {
        console.error(err);
        loadingText.textContent = "Error loading care homes.";
      }
    }

    document.addEventListener("DOMContentLoaded", fetchCareHomes);
  </script>

  
</html>
