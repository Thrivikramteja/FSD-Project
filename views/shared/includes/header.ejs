<header id="main-header" style="margin-bottom: 5rem;">
  <div id="logo"><a href="/">CareConnect</a></div>
  <nav>
    <ul class="nav-items">
      <li class="dropdown">
        <a class="dropdown-toggle">Donate</a>
        <ul class="dropdown-menu">
          <li><a href="/donate_items">Items</a></li>
          <li><a href="/donate_money">Money</a></li>
        </ul>
      </li>
      <li class="dropdown">
        <a class="dropdown-toggle">Discover</a>
        <ul class="dropdown-menu">
          <li><a href="/events">Events</a></li>
          <li><a href="/carehomes">Carehomes</a></li>
          <li><a href="/fundraisers">Fundraisers</a></li>
          <li><a href="/NGOs">NGOs</a></li>
        </ul>
      </li>
      <% if (!user) { %>
      <li class="dropdown">
        <a class="dropdown-toggle">Register</a>
        <ul class="dropdown-menu">
          <li><a href="/registerNgo">As an NGO</a></li>
          <li><a href="/registerCarehome">As a Carehome</a></li>
        </ul>
      </li>
      <% } %>

      <% if (!user) { %>
        <li id="login-button"><a href="/login" id="loginPopupBtn">Login</a></li>
        <li id="signup-button"><a href="/signup" id="loginPopupBtn">Signup</a></li>
      <% } else { %>
        <li id="logout-button"><a href="/logout">Logout</a></li>
      <% } %>

      <% if (user && userRole == "Donor") { %>
        <li><a id="profile" href="/profile/<%= userRole %>/<%= user.userId %>">Profile</a></li>
      <% } else if (user && userRole == "Carehome") { %>
        <li><a id="profile" href="/profile/<%= userRole %>/<%= user.carehomeId %>">Profile</a></li>
      <% } else if (user && userRole == "NGO") { %>
        <li><a id="profile" href="/profile/<%= userRole %>/<%= user.ngoId %>">Profile</a></li>
      <% } %>

    </ul>
  </nav>
</header>
