<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>CareConnect - Care Homes</title>
    <link rel="stylesheet" href="/carehome.css"> 
</head>
<body>
    <h1>List of Care Homes Associated with CareConnect</h1>
    <div class="container">
        <% careHomes.forEach(function(careHome) { %>
            <div class="card">
                <div class="logo">
                    <img src="<%= careHome.logo %>" alt="<%= careHome.name %> Logo">
                </div>
                <div class="content">
                    <h2><%= careHome.name %></h2>
                    <ul>
                        <% careHome.categories.forEach(function(category) { %>
                            <li><a href="#"><%= category.main %></a> -> <a href="#"><%= category.sub %></a></li>
                        <% }) %>
                        <div class="location">
                            <a href="#"><%= careHome.location %></a>
                        </div>
                    </ul>
                    <p><%= careHome.description %></p>
                </div>
            </div>
        <% }) %>
    </div>
</body>
</html>