// donate.ejs

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Donate Directly</title>
    <link rel="stylesheet" href="/donate_mon.css">
</head>
<body>
    <div class="choose_someone">
        
    </div>
    <div class="donation_main">
        <div class="user_det">
            <div class="fill_money">
                <h2>Donation Amount</h2>
                <div class="popular_options">
                    <button class="options">1000</button>
                    <button class="options">2000</button>
                    <button class="options">3000</button>
                </div>
                <div class="amount-input">
                    <span class="currency-symbol">₹</span>
                    <input id="anyamount" type="number" placeholder="Enter custom amount" min="1" max="1000000">
                    <div class="error-message" id="amountError">Please enter a valid amount up to 10 lakhs</div>
                </div>
                <div class="tip">
                    <div class="tip-label">
                        <span>Give Tip (8%):</span>
                    </div>
                    <div id="show_tip">₹0.00</div>
                </div>
                <p class="tip-note">Tips help us scale the platform</p>
            </div>
            <div class="user_details">
                <h2>Your Details</h2>
                <form id="donationForm" action="/donate" method="POST">
                    <div class="form-group">
                        <label for="name">Full name</label>
                        <input type="text" name="name" required>
                    </div>
                    <div class="form-group">
                        <label for="phone">Phone number</label>
                        <input type="tel" name="phone" pattern="[0-9]{10}" required>
                    </div>
                    <div class="form-group">
                        <label for="email">Email</label>
                        <input type="email" name="email" required>
                    </div>
                    <div class="form-group">
                        <label for="pan">PAN Number</label>
                        <input type="text" name="pan" pattern="[A-Z]{5}[0-9]{4}[A-Z]{1}" required>
                    </div>
                    <button type="submit" class="submit-btn">Proceed to Pay</button>
                </form>
                <p class="secured-payment">All payments are securely processed</p>
            </div>
            <div class="invoice_final">
                <div class="invoice-content">
                    <h3 id="choosen_one"><%= nonprofitName %></h3>
                    <p id="org-description">Providing compassionate care for elderly residents since 2005</p>
                    <div class="invoice-details">
                        <div class="invoice-row">
                            <span>Donation Amount:</span>
                            <span id="invoiceDonation">₹0.00</span>
                        </div>
                        <div class="invoice-row">
                            <span>Platform Tip (8%):</span>
                            <span id="invoiceTip">₹0.00</span>
                        </div>
                        <hr>
                        <div class="invoice-row total">
                            <span>Total Amount:</span>
                            <span id="invoiceTotal">₹0.00</span>
                        </div>
                    </div>
                    <button class="pay-now-btn" disabled>
                        <span class="button-text">Confirm Payment</span>
                    </button>
                </div>
            </div>
            
        </div>
    </div>
    <script src="/donate_moneyy.js"></script>
</body>
</html>