<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Fundraisers</title>
    <link rel="stylesheet" href="/styles/footer.css" />
    <link rel="stylesheet" href="/styles/slide.css" />
    <link rel="stylesheet" href="/styles/landing_page.css" />

  </head>
  <body>
    <%- include('../shared/includes/header') %>
    <section class="nonprofit-container">
      
      <% ongoing_fund.forEach(ongoing_fun => { %>
      <div class="nonprofit-card">
        <img style="width: 400px;" src="/<%= ongoing_fun.imagePath %>" alt="Fundraiser Theme image">
        <h3><%= ongoing_fun.fundraiser_name %></h3>

        <p class="fundraiser-tag">Tag: <%= ongoing_fun.tag %></p>
        <div class="info">
          <input type="hidden" name="id_NGO" id="ngoId" value="<%= ongoing_fun.ngoId %>">
          <div>
            <h4>₹<%= ongoing_fun.amount_raised_so_far.toLocaleString() %></h4>
            <p>Amount Raised</p>
          </div>
          <div>
            <h4>₹<%= ongoing_fun.goal_amount %></h4>
            <p>Goal Amount</p>
          </div>
        </div>
        <div class="buttons">
          <a href="/donate_fundraiser/<%= ongoing_fun.ngoId %>/<%= ongoing_fun.fundraiser_name %>">
            <button class="select-btn" style="justify-content: center;">Donate</button>
          </a>
        </div>
      </div>
      <% }) %>
    </section>
    <%- include('../shared/includes/footer') %>
  </body>
</html>
