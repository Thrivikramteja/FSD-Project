<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>NGO Registration</title>
    <link rel="stylesheet" href="styles/ngo_registration.css">
    <script defer src="scripts/ngo_reg.js"></script>
</head>
<body>
    <div class="container">
        <h1 id="ngo_display_name">NGO Registration</h1>
        <form id="ngo_form">
            <h2>NGO Details</h2>
            <label for="name">NGO Name</label>
            <input type="text" id="name" name="name" required>

            <label for="darpan_id">DARPAN ID</label>
            <input type="text" id="darpan_id" name="darpan_id" required>

            <label for="year_established">Year of Establishment</label>
            <input type="number" id="year_established" name="year_established"  required min="1800" max="2100">

            <h2>Contact Information</h2>
            <label for="email">Email</label>
            <input type="email" id="email" name="email" required>

            <label for="password">Password</label>
            <input type="password" id="password" name="password" required>

            <label for="confirm_password">Confirm Password</label>
            <input type="password" id="confirm_password" name="confirm_password" required>

            <label for="phone">Phone Number</label>
            <input type="tel" id="phone" name="phone"  required>

            <label for="address">Address</label>
            <textarea id="address" name="address" required></textarea>

            <h2>Bank & Payment Details</h2>
            <label for="bank_name">Bank Account Holder Name</label>
            <input type="text" id="bank_name" name="bank_name" required>

            <label for="account_number">Account Number</label>
            <input type="text" id="account_number" name="account_number" required>

            <label for="ifsc">IFSC Code</label>
            <input type="text" id="ifsc" name="ifsc" required>

            <button type="submit">Register</button>
        </form>
    </div>
</body>
</html>
