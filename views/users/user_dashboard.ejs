<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>User Dashboard</title>
  <link rel="stylesheet" href="/styles/landing_page.css" />
  <link rel="stylesheet" href="/styles/user_dashboard.css" />
  <link rel="stylesheet" href="/styles/footer.css" />
  <script src="/scripts/analytics_user.js" defer></script>
</head>

<body>
  <header id="main-header" style="margin-bottom: 5rem;">
    <div id="logo"><a href="/">CareConnect</a></div>
    <nav>
      <ul class="nav-items">
        <li class="dropdown">
          <a class="dropdown-toggle">Donate</a>
          <ul class="dropdown-menu">
            <li><a href="/donate_items">Items</a></li>
            <li><a href="/donate_money">Money</a></li>
          </ul>
        </li>
        <li class="dropdown">
          <a class="dropdown-toggle">Discover</a>
          <ul class="dropdown-menu">
            <li><a href="/events">Events</a></li>
            <li><a href="/carehomes">Carehomes</a></li>
            <li><a href="/fundraisers">Fundraisers</a></li>
            <li><a href="/NGOs">NGOs</a></li>
            <li><a href="/jobs">Jobs</a></li>
          </ul>
        </li>


        <% if (!user) { %>
          <li id="login-button"><a href="/login" id="loginPopupBtn">Login</a></li>
          <li id="signup-button"><a href="/signup" id="loginPopupBtn">Signup</a></li>
          <% } else { %>
            <li id="logout-button"><a href="/logout">Logout</a></li>
            <% } %>
              <% if (user) { %>
                <li><a id="edit" href="/user-dashboard/<%= user.userId %>/edit">Edit Profile</a></li>
                <% } %>

      </ul>
    </nav>
  </header>

  <div style="display: flex; justify-content: space-between; padding: 0 7rem 2rem 13rem;">
    <div class="name_right">
      <h1 style="font-size: 3rem; padding-top: 4rem">Welcome <br>
        <%= name %>
      </h1>
    </div>
    <div class="user_pro">
      <img src="/images/user.jpg" alt="profile" class="pro_img" />
      <p class="greet"></p>
      <button id="toggle-stats-btn">Statistics</button>
      <div id="user-stats" class="user-stats">
        <h2>Your Statistics</h2>
        <p class="text-title">Event Statistics:</p>
        <p class="text-body">
          <span id="event-count-current">Events Participated this month: </span><br />
          <span id="event-count-all">Total events Participated: </span><br />
        </p>
        <p class="text-title">Contribution:</p>
        <p class="text-body">
          <span id="donation-current">This month contribution: </span><br />
          <span id="donation-all">All-time contribution: </span><br />
          <span id="this_mon_don">This month donations:</span><br />
          <span id="all_time_con">All-time donations: </span><br />
        </p>
      </div>
    </div>
  </div>

  <div class="dashboard-container">
    <div class="body_2">
      <h2>Participated Events</h2>
      <div class="part_ev">
        <% if (participatedEvents && participatedEvents.length> 0) { %> <% participatedEvents.forEach(event=> { %>
            <div class="event">
              <h3>
                <%= event.event_name %>
              </h3>
              <p>
                <strong>Date: </strong><span class="date">
                  <%= event.event_date %>
                </span>
              </p>
            </div>
            <% }); %>
              <% } else { %>
                <p class="no-data">No participated events.</p>
                <% } %>
      </div>

      <h2>Fundraisers Contributed</h2>
      <div class="fund_pa">
        <% if (contributedFundraisers && contributedFundraisers.length> 0) {
          %> <% contributedFundraisers.forEach(fundraiser=> { %>
            <div class="event">
              <h3>
                <%= fundraiser.fundraiser_name %>
              </h3>
              <p>
                <strong>Amount Contributed: </strong><span class="money">
                  <%= fundraiser.amount_contributed %>
                </span>
              </p>
              <p>
                <strong>Status:</strong>
                <span class="status completed">Completed</span>
              </p>
              <p>
                <strong>Date: </strong><span class="date">
                  <%= fundraiser.contributed_at %>
                </span>
              </p>
            </div>
            <% }); %>
              <% } %>
                <% if (ongoingfund && ongoingfund.length> 0) { %>
                  <% for (let i=0; i < ongoingfund.length; ++i) { %>
                    <div class="event">
                      <h3>
                        <%= ongoingfund[i].fundraiser_name %>
                      </h3>
                      <p>
                        <strong>Amount Contributed: </strong><span class="money">
                          <%= ongoingfund[i].amount_contributed %>
                        </span>
                      </p>
                      <p>
                        <strong>Deadline:</strong>
                        <span class="status ongoing">
                          <%= ongoingfund[i].deadline %>
                        </span>
                      </p>
                      <p>
                        <strong>Date: </strong><span class="date">
                          <%= ongoingfund[i].contributed_at %>
                        </span>
                      </p>
                    </div>
                    <% } %>
                      <% } %>
                        <% if ((!contributedFundraisers || contributedFundraisers.length===0) && (!ongoingfund ||
                          ongoingfund.length===0)) { %>
                          <p class="no-data">No fundraisers contributed</p>
                          <% } %>
      </div>
    </div>

    <div class="up_side">
      <h2>Upcoming Events</h2>
      <div class="upcoming-events">
        <% if (upcomingEvents && upcomingEvents.length> 0) { %> <% upcomingEvents.forEach(event=> { %>
            <div class="regist_ev" style="margin-bottom: 2rem;">
              <h3>
                <%= event.event_name %>
              </h3>
              <p><strong>Date:</strong>
                <%= event.event_date %>
              </p>
              <p><strong>Location:</strong>
                <%= event.event_location %>
              </p>
            </div>
            <% }); %>
              <% } else { %>
                <p class="no-data">No upcoming events available.</p>
                <% } %>
      </div>
      <a class="register_more" style="text-decoration: none" href="/events">
        Register Yourself for more events...
      </a>
    </div>
  </div>

  <div class="messages_container">
    <h2>Recent Messages</h2>
    <div class="recent-messages">
      <% if (recentMessages && recentMessages.length> 0) { %>
        <% recentMessages.forEach(message=> { %>
          <div class="message">
            <div class="message-header">
              <span class="message-from">Category: <%= message.category %></span>
              <span class="message-date">
                Delivery:
                <%= message.delivery.toDateString() %>
              </span>

            </div>
            <p class="message-text">
              <%= message.message %>
            </p>
          </div>
          <% }); %>
            <% } else { %>
              <p class="no-data">No recent messages.</p>
              <% } %>
    </div>

  </div>
  <%- include('../shared/includes/footer') %>
</body>

</html>