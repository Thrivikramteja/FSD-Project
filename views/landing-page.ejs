<%- include('./shared/includes/head', { pageTitle: 'CareConnect' }) %>
    <!-- <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css"/> -->
    <link rel="stylesheet" href="/styles/faq.css">
    <link rel="stylesheet" href="/styles/slide.css">
    <link rel="stylesheet" href="/styles/events.css">
    <!-- <link rel="stylesheet" href="/styles/donate_mon.css">  -->
    <link rel="stylesheet" href="/styles/landing_page.css" />
    <link rel="stylesheet" href="/styles/footer.css">
  </head> 
  <body> 
    <%- include('./shared/includes/header') %>
    <main>
        <a href="/fundraisers" style="font-size: 20px; padding: 12px; text-decoration: none; margin-top: 20px; text-align: center; color: black; font-weight: 600">Fundraisers</a>
        <div class="nonprofit-container">
        <% ongoing_fund.forEach(ongoing_fun => { %>
            <div class="nonprofit-card" >
                <h3><%= ongoing_fun.fundraiser_name %></h3>
                <div class="info">
                    <div>
                        <h4>₹<%= ongoing_fun.amount_raised_so_far.toLocaleString() %></h4>
                        <p>Amount Raised</p>
                    </div>
                    <div>
                        <h4>₹<%= ongoing_fun.goal_amount %></h4>
                        <p>Goal Amount</p>
                    </div>
                </div>
                <div class="progress-bar">
                    <div 
                        class="progress" 
                        style="width: <%= (ongoing_fun.amount_raised_so_far / ongoing_fun.goal_amount * 100).toFixed(2) %>%;">
                    </div>
                </div>
            </div>
        <% }) %>
        </div>

      <a href="/events" style="font-size: 20px; padding: 12px; margin-top: 20px; text-decoration: none; text-align: center; color: black; font-weight: 600">NGO Events</a>
      <div class="nonprofit-container   ">
        <% upcoming_eve.forEach(event => { %>
            <div class="nonprofit-card" >
                <h3><%= event.event_name %></h3>
                <div class="info">
                    <div>
                        <h4><%= event.number_of_registrations.toLocaleString() %></h4>
                        <p>Supporters</p>
                    </div>
                </div>
            </div>
        <% }) %>
    </div>
    </main>
    <section>
      <%- include('./shared/includes/faq_section') %>
    </section>
    <%- include('./shared/includes/footer') %>
  </body>
</html>