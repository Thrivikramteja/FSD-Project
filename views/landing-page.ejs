    <%- include('./shared/includes/header') %>
    <main>
      <p style="font-size: 20px; padding: 12px; margin-top: 20px; text-align: center; color: black; font-weight: 600">Fundraisers</p>
      <div class="nonprofit-container">
        <% ongoing_fund.forEach(ongoing_fun => { %>
            <div class="nonprofit-card" >
                <h3><%= ongoing_fun.fundraiser_name %></h3>
                <div class="info">
                    <div>
                        <h4>₹<%= ongoing_fun.amount_raised_so_far.toLocaleString() %></h4>
                        <p>Amount Raised</p>
                    </div>
                </div>
                <div class="buttons">
                    <button class="details-btn">View details</button>
                    <a href="/donate/<%=(ongoing_fun.fundraiser_name) %>">
                        <button class="select-btn">Donate</button>
                    </a>
                </div>
            </div>
        <% }) %>
    </div>

      <p style="font-size: 20px; padding: 12px; margin-top: 20px; text-align: center; color: black; font-weight: 600">NGO Events</p>
      <div class="nonprofit-section">
        <% upcoming_eve.forEach(event => { %>
            <div class="nonprofit-card" >
                <h3><%= event.event_name %></h3>
                <div class="info">
                    <div>
                        <h4><%= event.number_of_registrations.toLocaleString() %></h4>
                        <p>Supporters</p>
                    </div>
                </div>
                <div class="buttons">
                    <button class="details-btn">View details</button>
                    <a href="/donate/<%=(event.event_name) %>">
                        <button class="select-btn">Register</button>
                    </a>
                </div>
            </div>
        <% }) %>
    </div>
