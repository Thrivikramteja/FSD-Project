{
  "/api/ngo/register": {
    "post": {
      "tags": ["NGO Management"],
      "summary": "Register NGO",
      "requestBody": {
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "Ngoname": { "type": "string" },
                "darpan_id": { "type": "string" },
                "year_established": { "type": "integer" },
                "email": { "type": "string" },
                "password": { "type": "string" },
                "phone": { "type": "string" },
                "address": { "type": "string" },
                "account_holder_name": { "type": "string" },
                "account_number": { "type": "string" },
                "ifsc": { "type": "string" }
              }
            }
          }
        }
      },
      "responses": { "201": { "description": "Success" } }
    }
  },
  "/api/ngo-dashboard/{ngoID}": {
    "get": {
      "tags": ["NGO Dashboard"],
      "summary": "Private Dashboard Stats",
      "security": [{ "bearerAuth": [] }],
      "parameters": [{ "name": "ngoID", "in": "path", "required": true, "schema": { "type": "integer" } }],
      "responses": { "200": { "description": "Success" } }
    }
  },
  "/api/ngo-dashboard/{ngoID}/create-fundraiser": {
    "post": {
      "tags": ["NGO Actions"],
      "summary": "Create Fundraiser",
      "security": [{ "bearerAuth": [] }],
      "parameters": [{ "name": "ngoID", "in": "path", "required": true, "schema": { "type": "integer" } }],
      "requestBody": {
        "content": {
          "multipart/form-data": {
            "schema": {
              "type": "object",
              "properties": {
                "id_carehome": { "type": "integer" },
                "fundraiser_name": { "type": "string" },
                "goal_amount": { "type": "number" },
                "deadline": { "type": "string", "format": "date" },
                "description": { "type": "string" },
                "tag": { "type": "string" },
                "image": { "type": "string", "format": "binary" }
              }
            }
          }
        }
      },
      "responses": { "200": { "description": "Success" } }
    }
  },
  "/api/ngo/{ngoID}/create-event": {
    "post": {
      "tags": ["NGO Actions"],
      "summary": "Create Event",
      "security": [{ "bearerAuth": [] }],
      "parameters": [{ "name": "ngoID", "in": "path", "required": true, "schema": { "type": "string" } }],
      "requestBody": {
        "content": {
          "multipart/form-data": {
            "schema": {
              "type": "object",
              "properties": {
                "event_name": { "type": "string" },
                "event_location": { "type": "string" },
                "deadline": { "type": "string", "format": "date", "description": "Mapped to event_date" },
                "event_time": { "type": "string" },
                "description": { "type": "string" },
                "image": { "type": "string", "format": "binary" }
              }
            }
          }
        }
      },
      "responses": { "200": { "description": "Success" } }
    }
  },
  "/api/NGO-dashboard/{ngoID}/edit": {
    "put": {
      "tags": ["NGO Dashboard"],
      "summary": "Update Profile",
      "security": [{ "bearerAuth": [] }],
      "parameters": [{ "name": "ngoID", "in": "path", "required": true, "schema": { "type": "string" } }],
      "requestBody": {
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "fullname": { "type": "string" },
                "phone": { "type": "string" },
                "bank": { "type": "string" },
                "accnum": { "type": "string" },
                "ifsc": { "type": "string" },
                "darpan": { "type": "string" }
              }
            }
          }
        }
      },
      "responses": { "200": { "description": "Success" } }
    }
  },
  "/api/NGO-dashboard/{ngoID}/details": {
    "get": {
      "tags": ["NGO Dashboard"],
      "summary": "Get Profile for Editing",
      "security": [{ "bearerAuth": [] }],
      "parameters": [{ "name": "ngoID", "in": "path", "required": true, "schema": { "type": "string" } }],
      "responses": { "200": { "description": "Success" } }
    }
  },
  "/api/ngos": {
    "get": {
      "tags": ["Public Services"],
      "summary": "NGO Directory",
      "responses": { "200": { "description": "Success" } }
    }
  },
  "/fundraisers": {
    "get": {
      "tags": ["Public Services"],
      "summary": "Global Fundraisers",
      "responses": { "200": { "description": "Success" } }
    }
  },
  "/api/events": {
    "get": {
      "tags": ["Public Services"],
      "summary": "Global Events",
      "responses": { "200": { "description": "Success" } }
    }
  },
  "/registerUser/{ngoID}": {
    "post": {
      "tags": ["Donor Actions"],
      "summary": "Event Registration",
      "security": [{ "bearerAuth": [] }],
      "parameters": [{ "name": "ngoID", "in": "path", "required": true, "schema": { "type": "string" } }],
      "requestBody": {
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "event": { "type": "string" }
              }
            }
          }
        }
      },
      "responses": { "200": { "description": "Success" } }
    }
  },
  "/api/NGOs/profile/{id}": {
    "get": {
      "tags": ["Public Services"],
      "summary": "NGO Public Profile",
      "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }],
      "responses": { "200": { "description": "Success" } }
    }
  }
}