{
  "/api/signup": {
    "post": {
      "tags": ["Authentication"],
      "summary": "Register new donor",
      "requestBody": {
        "required": true,
        "content": {
          "application/json": {
            "example": {
              "fullname": "John Doe",
              "mail": "john@example.com",
              "password": "123456",
              "phone": "9876543210",
              "checkbox": true
            }
          }
        }
      },
      "responses": {
        "201": {
          "description": "User registered successfully"
        },
        "409": {
          "description": "User already exists"
        }
      }
    }
  },

  "/api/login": {
    "post": {
      "tags": ["Authentication"],
      "summary": "Login with email and password (OTP will be sent)",
      "requestBody": {
        "required": true,
        "content": {
          "application/json": {
            "example": {
              "userRole": "Donor",
              "email": "john@example.com",
              "password": "123456"
            }
          }
        }
      },
      "responses": {
        "200": {
          "description": "OTP sent to email",
          "content": {
            "application/json": {
              "example": {
                "success": true,
                "twoFactorRequired": true,
                "email": "john@example.com",
                "role": "Donor",
                "message": "OTP sent to your email"
              }
            }
          }
        },
        "401": {
          "description": "Invalid credentials"
        },
        "404": {
          "description": "User not found"
        }
      }
    }
  },

  "/api/verify-otp": {
    "post": {
      "tags": ["Authentication"],
      "summary": "Verify OTP and login user",
      "requestBody": {
        "required": true,
        "content": {
          "application/json": {
            "example": {
              "email": "john@example.com",
              "otp": "123456",
              "userRole": "Donor"
            }
          }
        }
      },
      "responses": {
        "200": {
          "description": "Login successful",
          "content": {
            "application/json": {
              "example": {
                "success": true,
                "role": "Donor",
                "user": {},
                "redirect": "/donor-dashboard/101"
              }
            }
          }
        },
        "401": {
          "description": "Invalid or expired OTP"
        }
      }
    }
  },

  "/api/forgot-password": {
    "post": {
      "tags": ["Authentication"],
      "summary": "Send OTP for password reset",
      "requestBody": {
        "required": true,
        "content": {
          "application/json": {
            "example": {
              "email": "john@example.com",
              "userRole": "Donor"
            }
          }
        }
      },
      "responses": {
        "200": {
          "description": "OTP sent to email"
        },
        "404": {
          "description": "User not found"
        }
      }
    }
  },

  "/api/logout": {
    "post": {
      "tags": ["Authentication"],
      "summary": "Logout user (clears JWT cookie)",
      "responses": {
        "200": {
          "description": "Logged out successfully"
        }
      }
    }
  },

  "/api/me": {
    "get": {
      "tags": ["Authentication"],
      "summary": "Get current authenticated user",
      "security": [{ "bearerAuth": [] }],
      "responses": {
        "200": {
          "description": "Authenticated user data",
          "content": {
            "application/json": {
              "example": {
                "success": true,
                "user": {},
                "role": "Donor"
              }
            }
          }
        },
        "401": {
          "description": "Unauthorized"
        }
      }
    }
  }
}