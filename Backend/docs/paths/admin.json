{
  "/api/admin/dashboard": {
    "get": {
      "tags": ["Admin Dashboard"],
      "summary": "Retrieve Admin Platform Dashboard Metrics",
      "description": "Returns platform statistics including revenue, total NGOs, carehomes, events, and top fundraisers.",
      "security": [{ "bearerAuth": [] }],
      "responses": {
        "200": {
          "description": "Admin dashboard metrics retrieved successfully",
          "content": {
            "application/json": {
              "example": {
                "highest_Donation": 50000,
                "high_con_name": "Rahul Sharma",
                "total_revenue": 85000,
                "total_ngo": 12,
                "total_care": 8,
                "total_events": 20,
                "total_money": 1000000,
                "top_fund": [
                  {
                    "fundraiser_name": "Medical Aid",
                    "amount_raised_so_far": 120000
                  }
                ],
                "monthlyBusiness": [
                  { "name": "Jan", "profit": "3200.50" },
                  { "name": "Feb", "profit": "5400.00" }
                ]
              }
            }
          }
        }
      }
    }
  },

  "/api/admin/main-stats": {
    "get": {
      "tags": ["Admin Dashboard"],
      "summary": "Retrieve Core Platform Stats",
      "description": "Returns same aggregated statistics used in the admin dashboard.",
      "responses": {
        "200": {
          "description": "Statistics retrieved"
        }
      }
    }
  },

  "/api/admin/events-analytics": {
    "get": {
      "tags": ["Admin Analytics"],
      "summary": "Get Event Analytics",
      "description": "Returns analytics of events grouped into ongoing, upcoming, and completed events along with the most influential NGO and event.",
      "security": [{ "bearerAuth": [] }],
      "responses": {
        "200": {
          "description": "Event analytics retrieved successfully",
          "content": {
            "application/json": {
              "example": {
                "success": true,
                "analytics": {
                  "influentialNgo": {
                    "name": "Helping Hands",
                    "impact": 120
                  },
                  "influentialEvent": {
                    "event_name": "Charity Run",
                    "number_of_registrations": 200
                  }
                },
                "groups": {
                  "ongoing": [],
                  "upcoming": [],
                  "completed": []
                }
              }
            }
          }
        }
      }
    }
  },

  "/api/admin/event-registrations/{eventObjectId}": {
    "get": {
      "tags": ["Admin Analytics"],
      "summary": "Get Event Registrations",
      "description": "Returns a list of users registered for a specific event.",
      "security": [{ "bearerAuth": [] }],
      "parameters": [
        {
          "name": "eventObjectId",
          "in": "path",
          "required": true,
          "schema": { "type": "string" }
        }
      ],
      "responses": {
        "200": {
          "description": "Event registrations retrieved",
          "content": {
            "application/json": {
              "example": {
                "success": true,
                "registrationList": [
                  {
                    "name": "John Doe",
                    "userId": 101,
                    "registeredAt": "2025-03-10T10:22:00Z"
                  }
                ]
              }
            }
          }
        }
      }
    }
  },

  "/api/admin/fundraisers-analytics": {
    "get": {
      "tags": ["Admin Analytics"],
      "summary": "Get Fundraiser Analytics",
      "description": "Provides analytics for fundraisers including top ongoing campaigns and NGO revenue statistics.",
      "security": [{ "bearerAuth": [] }],
      "responses": {
        "200": {
          "description": "Fundraiser analytics retrieved",
          "content": {
            "application/json": {
              "example": {
                "success": true,
                "analytics": {
                  "top3Ongoing": [],
