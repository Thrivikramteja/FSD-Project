  "/api/admin/delete-carehome": {
    "delete": {
      "tags": ["Admin Management"],
      "summary": "Delete Carehome Account",
      "description": "Removes a carehome from the platform and sends an email notification explaining the reason.",
      "security": [{ "bearerAuth": [] }],
      "parameters": [
        {
          "name": "carehomeId",
          "in": "query",
          "required": true,
          "schema": { "type": "integer" },
          "description": "Unique identifier of the carehome"
        },
        {
          "name": "email",
          "in": "query",
          "required": true,
          "schema": { "type": "string" },
          "description": "Email address where the notification will be sent"
        },
        {
          "name": "name",
          "in": "query",
          "required": true,
          "schema": { "type": "string" },
          "description": "Name of the carehome"
        },
        {
          "name": "reason",
          "in": "query",
          "required": true,
          "schema": { "type": "string" },
          "description": "Reason for deleting the carehome"
        }
      ],
      "responses": {
        "200": {
          "description": "Carehome deleted successfully",
          "content": {
            "application/json": {
              "example": {
                "success": true
              }
            }
          }
        },
        "500": {
          "description": "Server error while deleting carehome"
        }
      }
    }
  }
}